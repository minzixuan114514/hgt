<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>HGT</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0a0a0a;color:#e5e5e5;min-height:100vh;overflow-x:hidden}
.header{position:sticky;top:0;background:#0a0a0a;border-bottom:1px solid #222;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;z-index:100}
.header h1{font-size:18px;font-weight:700;color:#fff}
.btn-back{background:none;border:none;color:#3b82f6;font-size:14px;cursor:pointer;padding:4px 8px}
.container{padding:16px;max-width:600px;margin:0 auto}
.btn-primary{background:#3b82f6;color:#fff;border:none;border-radius:10px;padding:12px 20px;font-size:15px;font-weight:600;cursor:pointer;width:100%;display:block;text-align:center}
.btn-primary:disabled{opacity:.5;cursor:not-allowed}
.btn-outline{background:transparent;color:#3b82f6;border:1.5px solid #3b82f6;border-radius:10px;padding:10px 16px;font-size:14px;font-weight:500;cursor:pointer}
.input-field{background:#1a1a1a;border:1px solid #333;border-radius:10px;padding:12px 14px;font-size:15px;color:#e5e5e5;width:100%;outline:none;margin-bottom:12px}
.input-field:focus{border-color:#3b82f6}
textarea.input-field{resize:vertical;min-height:80px}
.card{background:#151515;border:1px solid #222;border-radius:14px;padding:16px;margin-bottom:12px;cursor:pointer;transition:background .2s}
.card:active{background:#1e1e1e}
.card h3{font-size:16px;color:#fff;margin-bottom:6px}
.card p{font-size:13px;color:#888;margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-footer{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#666}
.card-footer .author{color:#3b82f6}
.badge{background:#222;padding:3px 10px;border-radius:20px;font-size:12px;color:#aaa}
.fab{position:fixed;bottom:24px;right:20px;width:56px;height:56px;background:#3b82f6;color:#fff;border:none;border-radius:50%;font-size:28px;cursor:pointer;box-shadow:0 4px 20px rgba(59,130,246,.4);z-index:99;display:flex;align-items:center;justify-content:center}
.page{display:none}
.page.active{display:block}
.empty{text-align:center;padding:60px 20px;color:#666;font-size:15px}
.room-code-display{background:#1a1a1a;border:2px dashed #3b82f6;border-radius:12px;padding:16px;text-align:center;margin:16px 0}
.room-code-display .code{font-size:28px;font-weight:700;color:#3b82f6;letter-spacing:4px}
.chat-area{background:#111;border:1px solid #222;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;height:calc(100vh - 280px)}
.chat-messages{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
.chat-msg{max-width:80%;padding:10px 14px;border-radius:14px;font-size:14px;line-height:1.4}
.chat-msg.sent{align-self:flex-end;background:#3b82f6;color:#fff;border-bottom-right-radius:4px}
.chat-msg.recv{align-self:flex-start;background:#1e1e1e;color:#e5e5e5;border-bottom-left-radius:4px}
.chat-msg .msg-sender{font-size:11px;color:#888;margin-bottom:4px}
.chat-msg.sent .msg-sender{color:#93c5fd}
.chat-input-bar{display:flex;gap:8px;padding:12px;border-top:1px solid #222;background:#0f0f0f}
.chat-input-bar input{flex:1;background:#1a1a1a;border:1px solid #333;border-radius:20px;padding:10px 14px;color:#e5e5e5;font-size:14px;outline:none}
.chat-input-bar input:focus{border-color:#3b82f6}
.chat-input-bar button{background:#3b82f6;color:#fff;border:none;border-radius:20px;padding:10px 16px;font-size:14px;cursor:pointer;white-space:nowrap}
.like-btn{background:none;border:none;color:#ef4444;font-size:15px;cursor:pointer;display:flex;align-items:center;gap:4px;padding:4px 8px}
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px}
.modal{background:#1a1a1a;border:1px solid #333;border-radius:16px;padding:20px;width:100%;max-width:400px}
.modal h2{font-size:18px;margin-bottom:16px;color:#fff}
.modal-actions{display:flex;gap:10px;margin-top:16px}
.modal-actions .btn-primary{flex:1}
.btn-cancel{flex:1;background:#333;color:#ccc;border:none;border-radius:10px;padding:12px;font-size:15px;font-weight:600;cursor:pointer}
.join-bar{display:flex;gap:8px;margin-bottom:16px}
.join-bar input{flex:1}
.join-bar button{white-space:nowrap;width:auto}
.room-list{margin-top:20px}
.room-list h2{font-size:16px;margin-bottom:12px;color:#fff}
.detail-answer{background:#111;border-left:3px solid #3b82f6;padding:14px;border-radius:0 10px 10px 0;margin:16px 0;font-size:15px;line-height:1.6;color:#ccc}
.detail-stats{display:flex;gap:16px;margin-bottom:20px;font-size:13px;color:#888}
.detail-stats span{display:flex;align-items:center;gap:4px}
.section-title{font-size:14px;color:#666;margin-bottom:8px;text-transform:uppercase;letter-spacing:1px}
.tab-bar{display:flex;gap:8px;margin-bottom:16px;overflow-x:auto;padding-bottom:4px}
.tab-bar button{background:#1a1a1a;color:#888;border:1px solid #333;border-radius:20px;padding:8px 16px;font-size:13px;cursor:pointer;white-space:nowrap}
.tab-bar button.active{background:#3b82f6;color:#fff;border-color:#3b82f6}
</style>
</head>
<body>

<!-- ====== 页面：主页 ====== -->
<div class="page active" id="page-home">
  <div class="header">
    <h1>HGT</h1>
  </div>
  <div class="container">
    <div class="tab-bar">
      <button class="active" onclick="switchTab('latest')">最新</button>
      <button onclick="switchTab('hot')">最热</button>
      <button onclick="showPage('rooms')">房间</button>
    </div>
    <div class="join-bar">
      <input class="input-field" id="join-code-input" placeholder="输入房间码加入…" style="margin-bottom:0">
      <button class="btn-outline" onclick="joinRoomByCode()">加入</button>
    </div>
    <div id="questions-list"></div>
  </div>
  <button class="fab" onclick="showCreateQuestion()">+</button>
</div>

<!-- ====== 页面：问题详情 ====== -->
<div class="page" id="page-detail">
  <div class="header">
    <button class="btn-back" onclick="showPage('home')">← 返回</button>
    <h1>题目详情</h1>
    <span></span>
  </div>
  <div class="container">
    <h2 id="detail-title" style="font-size:20px;margin-bottom:8px"></h2>
    <div class="detail-stats">
      <span>👤 <span id="detail-author"></span></span>
      <span>🕐 <span id="detail-time"></span></span>
      <span id="detail-like-wrap">
        <button class="like-btn" id="detail-like-btn" onclick="toggleLike()">❤️ <span id="detail-likes">0</span></button>
      </span>
    </div>
    <div class="detail-answer" id="detail-answer"></div>
    <button class="btn-primary" onclick="showCreateRoom()" style="margin-top:20px">🏠 创建房间讨论</button>
  </div>
</div>

<!-- ====== 页面：房间 ====== -->
<div class="page" id="page-room">
  <div class="header">
    <button class="btn-back" onclick="leaveRoom()">← 离开</button>
    <h1 id="room-header-title">房间</h1>
    <span></span>
  </div>
  <div class="container" style="padding:8px 16px">
    <div class="room-code-display">
      <div style="font-size:12px;color:#888;margin-bottom:4px">房间码（分享给好友）</div>
      <div class="code" id="room-code"></div>
    </div>
    <div class="chat-area">
      <div class="chat-messages" id="chat-messages"></div>
      <div class="chat-input-bar">
        <input id="chat-input" placeholder="发消息…" onkeydown="if(event.key==='Enter')sendMsg()">
        <button onclick="sendMsg()">发送</button>
      </div>
    </div>
  </div>
</div>

<!-- ====== 弹窗：创建题目 ====== -->
<div class="modal-overlay" id="modal-create-q" style="display:none">
  <div class="modal">
    <h2>创建题目</h2>
    <input class="input-field" id="new-q-title" placeholder="题目">
    <textarea class="input-field" id="new-q-answer" placeholder="答案"></textarea>
    <input class="input-field" id="new-q-author" placeholder="你的名字（可选）">
    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeModal('modal-create-q')">取消</button>
      <button class="btn-primary" onclick="createQuestion()">发布</button>
    </div>
  </div>
</div>

<!-- ====== 弹窗：创建房间 ====== -->
<div class="modal-overlay" id="modal-create-room" style="display:none">
  <div class="modal">
    <h2>创建房间</h2>
    <input class="input-field" id="new-room-code" placeholder="房间码（如 A1B2）">
    <input class="input-field" id="new-room-host" placeholder="你的名字">
    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeModal('modal-create-room')">取消</button>
      <button class="btn-primary" onclick="createRoom()">创建并进入</button>
    </div>
  </div>
</div>

<script>
// ========== 配置（替换这里！） ==========
const SUPABASE_URL = "https://dsnyuwwnlrfplzlgwifq.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRzbnl1d3dubHJmcGx6bGd3aWZxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1NTMxMTcsImV4cCI6MjEwNTEyOTExN30.yiADJTeqqMrpDbeLJP3l4PMgutgbqxIa9hTRM3W3JOw";
// ========================================

const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let currentQuestionId = null;
let currentRoomCode = null;
let myName = localStorage.getItem("hgt_name") || "";
let chatUnsub = null;
let currentTab = "latest";

// 页面切换
function showPage(name) {
  document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
  document.getElementById("page-" + name).classList.add("active");
  if (name === "home") loadQuestions();
}

// Tab 切换
function switchTab(tab) {
  currentTab = tab;
  document.querySelectorAll(".tab-bar button").forEach(b => b.classList.remove("active"));
  event.target.classList.add("active");
  loadQuestions();
}

// 加载题目列表
async function loadQuestions() {
  const list = document.getElementById("questions-list");
  list.innerHTML = '<div style="text-align:center;padding:40px;color:#666">加载中…</div>';

  let query = supabase.from("questions").select("*");
  if (currentTab === "hot") {
    query = query.order("likes", { ascending: false });
  } else {
    query = query.order("created_at", { ascending: false });
  }

  const { data, error } = await query;
  if (error) {
    list.innerHTML = '<div class="empty">加载失败：' + error.message + '</div>';
    return;
  }

  if (!data || data.length === 0) {
    list.innerHTML = '<div class="empty">还没有题目，点击右下角 + 创建第一个！</div>';
    return;
  }

  list.innerHTML = data.map(q => `
    <div class="card" onclick="openQuestion(${q.id})">
      <h3>${escapeHtml(q.title)}</h3>
      <p>${escapeHtml(q.answer)}</p>
      <div class="card-footer">
        <span class="author">${escapeHtml(q.author || "匿名")}</span>
        <span class="badge">❤️ ${q.likes || 0}</span>
      </div>
    </div>
  `).join("");
}

// 打开题目详情
async function openQuestion(id) {
  currentQuestionId = id;
  const { data, error } = await supabase.from("questions").select("*").eq("id", id).single();
  if (error || !data) return alert("加载失败");

  document.getElementById("detail-title").textContent = data.title;
  document.getElementById("detail-answer").textContent = data.answer;
  document.getElementById("detail-author").textContent = data.author || "匿名";
  document.getElementById("detail-likes").textContent = data.likes || 0;
  document.getElementById("detail-time").textContent = new Date(data.created_at).toLocaleString("zh-CN");

  showPage("detail");
}

// 点赞
async function toggleLike() {
  if (!currentQuestionId) return;
  const { data: q } = await supabase.from("questions").select("likes").eq("id", currentQuestionId).single();
  const newLikes = (q.likes || 0) + 1;
  await supabase.from("questions").update({ likes: newLikes }).eq("id", currentQuestionId);
  document.getElementById("detail-likes").textContent = newLikes;
}

// 创建题目
function showCreateQuestion() {
  document.getElementById("modal-create-q").style.display = "flex";
}

async function createQuestion() {
  const title = document.getElementById("new-q-title").value.trim();
  const answer = document.getElementById("new-q-answer").value.trim();
  const author = document.getElementById("new-q-author").value.trim();
  if (!title || !answer) return alert("题目和答案不能为空");

  const { error } = await supabase.from("questions").insert([{ title, answer, author: author || "匿名" }]);
  if (error) return alert("发布失败：" + error.message);

  if (author) localStorage.setItem("hgt_name", author);
  closeModal("modal-create-q");
  document.getElementById("new-q-title").value = "";
  document.getElementById("new-q-answer").value = "";
  document.getElementById("new-q-author").value = "";
  loadQuestions();
}

// 创建房间
function showCreateRoom() {
  document.getElementById("new-room-code").value = generateCode();
  document.getElementById("new-room-host").value = myName;
  document.getElementById("modal-create-room").style.display = "flex";
}

async function createRoom() {
  const code = document.getElementById("new-room-code").value.trim().toUpperCase();
  const host = document.getElementById("new-room-host").value.trim();
  if (!code) return alert("房间码不能为空");
  if (!myName && !host) return alert("请输入你的名字");

  myName = host;
  localStorage.setItem("hgt_name", myName);

  const { error } = await supabase.from("rooms").insert([{ room_code: code, question_id: currentQuestionId, host_name: host }]);
  if (error) return alert("创建失败，房间码可能已被使用：" + error.message);

  closeModal("modal-create-room");
  enterRoom(code);
}

// 加入房间
async function joinRoomByCode() {
  const code = document.getElementById("join-code-input").value.trim().toUpperCase();
  if (!code) return;
  if (!myName) {
    const name = prompt("请输入你的名字：");
    if (!name) return;
    myName = name;
    localStorage.setItem("hgt_name", myName);
  }
  const { data } = await supabase.from("rooms").select("*").eq("room_code", code).single();
  if (!data) return alert("找不到该房间码");
  enterRoom(code);
}

// 进入房间
function enterRoom(code) {
  currentRoomCode = code;
  document.getElementById("room-code").textContent = code;
  document.getElementById("chat-messages").innerHTML = "";
  showPage("room");
  loadChatHistory();
  subscribeChat();
}

// 离开房间
function leaveRoom() {
  if (chatUnsub) { chatUnsub(); chatUnsub = null; }
  currentRoomCode = null;
  showPage("home");
}

// 加载聊天历史
async function loadChatHistory() {
  const { data } = await supabase.from("room_chats").select("*").eq("room_code", currentRoomCode).order("created_at", { ascending: true });
  if (!data) return;
  const container = document.getElementById("chat-messages");
  container.innerHTML = "";
  data.forEach(m => appendChatMsg(m, false));
  scrollChat();
}

// 实时订阅
function subscribeChat() {
  chatUnsub = supabase.channel("chat-" + currentRoomCode)
    .on("postgres_changes", { event: "INSERT", schema: "public", table: "room_chats", filter: "room_code=eq." + currentRoomCode }, payload => {
      appendChatMsg(payload.new, true);
    })
    .subscribe();
}

// 添加聊天消息到界面
function appendChatMsg(m, animate) {
  const container = document.getElementById("chat-messages");
  const isSent = m.sender === myName;
  const div = document.createElement("div");
  div.className = "chat-msg " + (isSent ? "sent" : "recv");
  div.innerHTML = `<div class="msg-sender">${escapeHtml(m.sender || "匿名")}</div>${escapeHtml(m.content || "")}`;
  container.appendChild(div);
  if (animate) scrollChat();
}

function scrollChat() {
  const c = document.getElementById("chat-messages");
  c.scrollTop = c.scrollHeight;
}

// 发送消息
async function sendMsg() {
  const input = document.getElementById("chat-input");
  const content = input.value.trim();
  if (!content || !currentRoomCode || !myName) return;
  input.value = "";
  await supabase.from("room_chats").insert([{ room_code: currentRoomCode, msg_type: "text", sender: myName, content }]);
}

// 弹窗
function closeModal(id) { document.getElementById(id).style.display = "none"; }

// 工具函数
function escapeHtml(s) {
  if (!s) return "";
  return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

function generateCode() {
  const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  let c = "";
  for (let i = 0; i < 4; i++) c += chars[Math.floor(Math.random() * chars.length)];
  return c;
}

// 初始化
loadQuestions();
</script>
</body>
</html>
